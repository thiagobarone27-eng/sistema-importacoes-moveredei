DATABASE_URL="file:./dev.db"
PORT=4000

# Autenticacao (login) --------------------------------------------------
# Chave usada para assinar os tokens de sessao (JWT). Gere um valor
# aleatorio e longo, ex: openssl rand -hex 32. NUNCA reutilize entre
# ambientes (dev/producao) nem versione o valor real.
JWT_SECRET="troque-por-um-valor-aleatorio-longo"

# Usadas apenas na PRIMEIRA vez que o sistema sobe (prisma/seed-admin.ts)
# para criar o usuario administrador inicial. Depois que esse usuario ja
# existir, essas variaveis podem ser removidas com seguranca - o script
# nunca sobrescreve usuarios existentes.
ADMIN_NOME="Administrador"
ADMIN_EMAIL="admin@moveredei.com"
ADMIN_SENHA_INICIAL="troque-esta-senha"
