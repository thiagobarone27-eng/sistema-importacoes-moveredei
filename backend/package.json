{
  "name": "moveredei-importacoes-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend do sistema de Gestao de Importacoes (Moveredei)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "prisma:migrate": "tsx prisma/migrate.ts",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed-admin": "tsx prisma/seed-admin.ts",
    "prisma:studio": "tsx prisma/studio-fallback.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.3",
    "kysely": "^0.29.5",
    "multer": "^1.4.5-lts.1",
    "tsx": "^4.19.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.4",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
